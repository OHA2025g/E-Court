server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Enable when TLS terminates at this nginx instance:
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ {
        proxy_pass ${API_PROXY_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_read_timeout 300s;
    }

    # Hashed CRA assets can be cached long-term.
    location /static/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        try_files $uri =404;
    }

    # index.html / SPA shell must not be cached, or browsers keep old JS after deploy.
    # Note: nginx does not inherit server-level add_header into locations that set their own.
    location = /index.html {
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        # CSP_CONNECT_SRC: set CSP_API_ORIGIN at container start when API is on another host.
        # worker-src blob: is required for PostHog session replay; without it some browsers
        # (notably Safari) log CSP errors and can fail to paint the SPA (blank white screen).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.i.posthog.com https://*.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; connect-src 'self' ${CSP_CONNECT_SRC} https://*.i.posthog.com https://*.posthog.com https://us.i.posthog.com https://us-assets.i.posthog.com; font-src 'self' data: https://fonts.gstatic.com; worker-src 'self' blob: data:; child-src 'self' blob:; frame-ancestors 'self';" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        try_files $uri =404;
    }

    # GeoJSON must not be served as octet-stream (breaks some browsers / map libs).
    location ~* \.geojson$ {
        default_type application/geo+json;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    location / {
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.i.posthog.com https://*.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; connect-src 'self' ${CSP_CONNECT_SRC} https://*.i.posthog.com https://*.posthog.com https://us.i.posthog.com https://us-assets.i.posthog.com; font-src 'self' data: https://fonts.gstatic.com; worker-src 'self' blob: data:; child-src 'self' blob:; frame-ancestors 'self';" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        try_files $uri $uri/ /index.html;
    }
}
